# Copy to .env and change the values: cp .env.example .env

# Postgres (used by the db container)
POSTGRES_USER=tesla
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tesla_pool

# Backend -> Postgres, for running the backend on your machine (pnpm dev).
# Must match the three values above. Inside Docker, compose builds its own URL with host "db".
DATABASE_URL=postgresql://tesla:change-me@localhost:5432/tesla_pool
